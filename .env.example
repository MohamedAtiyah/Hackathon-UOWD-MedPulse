# Copy to .env. Never commit real keys.
DATABASE_URL="file:./dev.db"
# Optional: enables LLM-backed triage/SOAP. Rule-based fallback runs when unset.
OPENAI_API_KEY=
# Optional overrides for the LLM layer (src/lib/llm.ts)
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
# Optional object-storage bucket for future document/image uploads.
STORAGE_BUCKET=medpulse-ai-dev
